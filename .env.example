NEXT_PUBLIC_STRATO_TENANT_ID=strato-demo

# Supabase PostgreSQL is accessed only by the STRATO server.
# For an IPv4 Hostinger server, copy the Supabase Session pooler URL (port 5432).
DATABASE_URL=postgresql://postgres.project-ref:replace_me@pooler-host:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_SSL=require

# Copiloto STRATO (somente no servidor; nunca use prefixo NEXT_PUBLIC_ na chave).
OPENAI_API_KEY=replace_me
# Modelo rápido para consultas e resumos operacionais.
OPENAI_MODEL=gpt-6-luna
# Opcional para gateways compatíveis ou proxy corporativo.
# OPENAI_BASE_URL=https://api.openai.com/v1
