{
  "name": "strato-receivables-os",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vinext start",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src app tests",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.3.0",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "supabase": "2.120.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "type": "module",
  "description": "STRATO · plataforma operacional de recebíveis (factoring, securitizadora, FIDC). Protótipo navegável com dados fictícios."
}
