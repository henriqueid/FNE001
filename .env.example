# Supabase public configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_STRATO_TENANT_ID=strato-demo

# Server-only configuration. Never expose these values to browser code.
SUPABASE_SECRET_KEY=replace_with_server_secret
DATABASE_URL=postgresql://strato_backend:replace_me@host:5432/postgres?sslmode=require
